{
  "name": "enrichment-kit",
  "version": "0.1.0",
  "description": "Open-source Clay.com alternative. Multi-vendor data enrichment waterfalls — bring your own API keys, pay ~85% less per lead.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "enrichment-kit": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "demo": "tsx examples/basic-enrichment.ts"
  },
  "keywords": [
    "enrichment",
    "lead-enrichment",
    "clay-alternative",
    "waterfall",
    "email-finder",
    "linkedin-finder",
    "apollo",
    "hunter",
    "serpapi",
    "data-enrichment",
    "sales-tools",
    "bring-your-own-key",
    "byok"
  ],
  "author": "Muhammad Shaheer <shaheerawan001@gmail.com> (https://github.com/masteranime)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/masteranime/enrichment-kit.git"
  },
  "homepage": "https://github.com/masteranime/enrichment-kit#readme",
  "bugs": {
    "url": "https://github.com/masteranime/enrichment-kit/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8",
    "p-retry": "^6.2.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
