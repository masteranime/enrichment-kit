# At least ONE provider must be configured.
# All have free tiers — see README for signup links.

# Hunter.io — 25 searches/month free
# https://hunter.io/api-keys
HUNTER_API_KEY=

# Apollo.io — 10k credits + 120 email credits/year free
# https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# SerpAPI — 100 searches/month free
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# LLM for SerpAPI extract stage. Pick ONE:
# Groq (fastest, generous free tier)  — https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI                              — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# Anthropic                           — https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Defaults to groq. Override if using OpenAI/Anthropic:
# LLM_PROVIDER=openai

# Optional providers
ANYMAILFINDER_API_KEY=
PROXYCURL_API_KEY=
